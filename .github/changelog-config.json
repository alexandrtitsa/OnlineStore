{
  "categories": [
    {
      "title": "## 🚀 Features",
      "labels": ["feat", "feature", "enhancement"]
    },
    {
      "title": "## 🐛 Bug Fixes",
      "labels": ["fix", "bugfix", "bug"]
    },
    {
      "title": "## 📚 Documentation",
      "labels": ["docs", "documentation"]
    },
    {
      "title": "## 🔧 Maintenance",
      "labels": ["chore", "dependencies", "refactor"]
    },
    {
      "title": "## ⚡ Performance",
      "labels": ["perf", "performance"]
    },
    {
      "title": "## 🧪 Tests",
      "labels": ["test", "tests"]
    }
  ],
  "ignore_labels": [
    "ignore",
    "skip-changelog"
  ],
  "sort": "ASC",
  "template": "${{CHANGELOG}}",
  "pr_template": "- ${{TITLE}} (#${{NUMBER}})",
  "empty_template": "- No changes",
  "label_extractor": [
    {
      "pattern": "^(feat|fix|docs|style|refactor|perf|test|chore)(\\(.+\\))?:",
      "target": "$1"
    }
  ]
}